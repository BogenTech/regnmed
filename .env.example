# regnmed configuration reference — EVERY environment variable the code
# reads, with dummy or empty values. Copy to `.env` for local development:
#
#     cp .env.example .env
#
# `.env` is gitignored and is localhost configuration only. THIS FILE MUST
# NEVER CONTAIN A REAL SECRET — docs/secrets.md is absolute, test as well as
# prod, with no carve-out. The placeholders below are deliberately invalid.
#
# In the cluster these are set by deploy/base + the overlays, and the ones
# marked SECRET come from Kubernetes secrets created out-of-band, never from
# a rendered manifest (docs/deploy.md). Exactly two secrets are required, in
# EVERY environment, and BOTH must exist BEFORE the first apply:
#
#   db-credentials       password, regnmed-url, regnid-url, restore-check-url
#   stripe-credentials   secret-key, webhook-secret
#
# Miss stripe-credentials and regnmed-api never starts at all — the pod sits
# in CreateContainerConfigError, visible only in pod events, while Postgres
# and the migrations look perfectly healthy.
#
# THIS FILE IS regnmed's CONFIGURATION ONLY. regnid (../regnid) is a separate
# service with its own variables — ISSUER, TRUST_PROXY, MAIL_BACKEND,
# MAIL_TRANSPORT and its own DATABASE_URL. Look there, not here, for those.
#
# Kept in sync by hand. If you add an env read, add it here — this list was
# verified against the source on 2026-07-30 and was complete as of then. Note
# that regnmed-gov/src/maskinporten.rs reads its variables through a local
# closure rather than `std::env::var` directly, so grepping for `env::var`
# alone under-reports by five.

# ---------------------------------------------------------------------------
# REQUIRED — regnmed-api refuses to start without these
# ---------------------------------------------------------------------------

# SECRET in the cluster: db-credentials/regnmed-url.
# Dev database: `docker compose up -d` or `scripts/dev-db.sh` (no Docker).
DATABASE_URL=postgres://regnmed:regnmed@localhost:5433/regnmed

# The OIDC identity provider — regnid, the sibling repo ../regnid. regnmed is
# a relying party ONLY: the token proves identity, and all authorization
# lives in regnmed's own database (person → firm → oppdrag → company). Never
# bake IdP specifics in here.
OIDC_ISSUER=https://id.example.invalid

# ---------------------------------------------------------------------------
# OPTIONAL — each unset value turns something off, loudly rather than silently
# ---------------------------------------------------------------------------

# Restrict which audience claim is accepted. Unset: audience is not checked.
#OIDC_AUDIENCE=regnmed

# Dev/tests only: load the JWKS from a file instead of OIDC discovery, so the
# API starts without a live IdP. Signatures are still fully validated.
#OIDC_JWKS_FILE=.dev/jwks.json

# BIND_ADDR is authoritative and is what deploy/ sets. PORT is only a fallback
# for dev harnesses that assign a free port. With neither set the default is
# 127.0.0.1:8080 — note the LOOPBACK, which is why a container must set
# BIND_ADDR explicitly or it accepts nothing from outside the pod.
#BIND_ADDR=127.0.0.1:8080
#PORT=8080

# The portal's public URL, used ONLY for the link in the invitation e-mail
# (#66). It is configuration and never the request's Host header, so a mail we
# send cannot be aimed anywhere by whoever called us. Unset: the invitation
# still goes out, just without a link.
#PORTAL_BASE_URL=https://regnmed.example.invalid

# The client_id the portal uses for OIDC code+PKCE. Default: regnmed-portal.
#PORTAL_OIDC_CLIENT_ID=regnmed-portal

# ---------------------------------------------------------------------------
# MAIL — one NATS JetStream rail, shared with regnid (never vendored)
# ---------------------------------------------------------------------------
# Outbound `regnid.mail.send`, inbound `regnid.mail.received`. UNSET means
# there is no consumer at all: sending invoices and reminders by e-mail
# returns a clear error rather than pretending, and inbound bilag-by-mail is
# off with the portal saying so. See docs/faktura.md and docs/epost-inn.md.
#NATS_URL=nats://localhost:4222
#NATS_USER=
# SECRET in the cluster, when the server requires authentication.
#NATS_PASSWORD=

# The domain inbound bilag addresses are shown under (#35). Set it only once
# that domain's MX actually delivers into regnid's receiver — otherwise the
# portal prints an address that silently receives nothing. An empty value is
# treated exactly like unset.
#MAIL_IN_DOMAIN=bilag.regnmed.example.invalid

# ---------------------------------------------------------------------------
# CARD RAIL — Stripe (#74, docs/abonnement.md §5)
# ---------------------------------------------------------------------------
# BOTH OR NEITHER. Setting exactly one is a startup error, not a degraded
# mode — a half configuration is an error, not a state. Unset: the rail is off
# and the endpoints say so.
#
# Both are SECRET in the cluster:
#   stripe-credentials/secret-key, stripe-credentials/webhook-secret
#
# The webhook secret must match the MODE of the key. Stripe issues one per
# mode, so a test secret against live keys rejects every real event as
# unsigned — and the failure looks like a signature bug, not a config one.
#STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key
#STRIPE_WEBHOOK_SECRET=whsec_placeholder_not_a_real_secret

# Point at a mock Stripe for tests. Unset: the real API.
#STRIPE_API_BASE=http://localhost:12111

# The orgnr of the operating company whose ledger subscription invoices and
# confirmed card payments post into. REQUIRED FOR THE CARD RAIL TO SETTLE:
# without it the webhook cannot tell which hovedbok a charge belongs to and
# returns an error — while Stripe has already taken the money. It must name
# the same company on regnmed-api AND on the abonnement CronJob, or invoices
# are issued in one ledger while the payments that settle them post in
# another, and the reskontro item never closes.
#REGNMED_DRIFT_ORGNR=999999999

# ---------------------------------------------------------------------------
# ANCHORING — external witness (docs/anchoring.md)
# ---------------------------------------------------------------------------
# RFC 3161 timestamp authority for the nightly Merkle root. Unset: anchoring
# still runs and still detects tampering, it simply is not independently
# witnessed. Deliberately unset in test — a timestamp is a claim about a REAL
# ledger, and asking a free service to witness a throwaway database nightly
# is noise on someone else's infrastructure.
#ANCHOR_TSA_URL=http://timestamp.example.invalid

# ---------------------------------------------------------------------------
# REGISTRY ENDPOINTS — defaults are the real public APIs; override for tests
# ---------------------------------------------------------------------------

# Brønnøysund Enhetsregisteret (orgnr onboarding).
#BRREG_API_URL=https://data.brreg.no/enhetsregisteret/api

# Finanstilsynet's autorisasjon register. THIS ONE HAS NO DEFAULT and the
# adapter is FAIL-CLOSED: unset, no professional autorisasjon can be
# verified, so no firm can be created and nobody can offer services in the
# marketplace. That is the safe direction, but it is a feature switch rather
# than a tuning knob. The endpoint is pinned during the pilot.
#FINANSTILSYNET_API_URL=

# Norges Bank's SDMX-JSON exchange-rate API.
#NORGES_BANK_URL=https://data.norges-bank.no

# Skatteetaten's mva-melding validation endpoint. The default is their SBS
# TEST environment, not production — deliberately, because live validation and
# submission are still gated on Maskinporten client registration
# (docs/gov.md, issue #8).
#MVA_VALIDATION_URL=https://idporten-api-sbstest.sits.no/api/mva/grensesnittstoette/mva-melding/valider

# ---------------------------------------------------------------------------
# MASKINPORTEN — five required together, one optional (docs/gov.md)
# ---------------------------------------------------------------------------
# MaskinportenConfig::from_env() fails naming the first missing variable, so a
# partial configuration cannot start. Only needed for the government
# integrations that submit rather than validate.
#
# THE PRIVATE KEY IS NEVER IN THIS REPO. It lives in ~/.config/regnmed/ and is
# deliberately NOT backed up: a second machine runs
# scripts/maskinporten-key.sh to generate its OWN keypair and registers that
# public key on the same client, and a lost machine is handled by deleting its
# key in Samarbeidsportalen. Maskinporten keys EXPIRE — that date is on the
# December regelverksrevisjon checklist.
#MASKINPORTEN_TOKEN_ENDPOINT=https://test.maskinporten.no/token
#MASKINPORTEN_AUDIENCE=https://test.maskinporten.no/
#MASKINPORTEN_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MASKINPORTEN_KEY_FILE=~/.config/regnmed/maskinporten-test.pem
#MASKINPORTEN_SCOPES=skatteetaten:mvameldingvalidering
# MASKINPORTEN_KID selects between keys, and is needed only when the client
# has more than one registered — which is exactly what the second-machine
# procedure above produces.
#MASKINPORTEN_KID=

# ---------------------------------------------------------------------------
# TESTS ONLY
# ---------------------------------------------------------------------------
# Set to a directory to make tests/seed_browser.rs seed a demo company and
# write a static JWKS there, for manual browser verification of the portal.
# Unset: that test does nothing, which is why it is run by hand.
#SEED_BROWSER=.dev/browser
